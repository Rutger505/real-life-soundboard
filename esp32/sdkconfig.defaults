# ESP-IDF settings for the soundboard. Boards WITH the 32.768 kHz crystal
# add sdkconfig.crystal on top (see the README).
#
# This is an ESP32 classic: its Bluetooth controller options are named
# BTDM_*. The BT_CTRL_* spellings belong to the C3/S3 and are silently ignored.

# --- Bluetooth: BLE-only Bluedroid GATT server ---
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
# GATTC stays on (the default): esp-idf-svc's client module does not build without it.
# The GATTS callbacks log and take a mutex; the 3 KB default is tight.
CONFIG_BT_BTC_TASK_STACK_SIZE=4096

# One phone at a time. Frees controller RAM and keeps the radio quiet.
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
CONFIG_BT_ACL_CONNECTIONS=1

# --- Power ---
# Radio powers down between connection events. Works on any board.
CONFIG_BTDM_CTRL_MODEM_SLEEP=y
CONFIG_BTDM_CTRL_MODEM_SLEEP_MODE_ORIG=y

# BLE low-power clock. The main crystal allows modem sleep and frequency
# scaling, but stops in light sleep, so the controller keeps the CPU awake
# while BLE is up. sdkconfig.crystal switches this to the 32.768 kHz crystal.
CONFIG_BTDM_CTRL_LPCLK_SEL_MAIN_XTAL=y

# Frequency scaling (and light sleep with the crystal). The min/max come from
# esp_pm_configure() in src/power.rs.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y

# 1 ms ticks, so the 5 ms matrix scan is 5 ms and not rounded up to 10.
# Tickless idle skips the ticks while nothing is due.
CONFIG_FREERTOS_HZ=1000

# --- System ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# --- Logging ---
# Warnings and errors only. Console output holds a power lock while it
# drains, and the strings cost flash. To see button presses and BLE events,
# switch to CONFIG_LOG_DEFAULT_LEVEL_INFO.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
