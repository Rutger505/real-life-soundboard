# --- Bluetooth: BLE-only Bluedroid GATT server ---
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_GATT_MAX_SR_PROFILES=8
CONFIG_BT_GATT_MAX_SR_SERVICES=8
CONFIG_BT_GATT_MAX_SR_CHARS=16

# One phone at a time. Frees controller RAM and keeps the radio off the air.
# Raise together with MAX_CONNECTIONS / ADVERTISE_WHILE_CONNECTED in src/ble.rs.
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
CONFIG_BT_ACL_CONNECTIONS=1

# --- Power ---
# NB: this is an ESP32 classic target, where the Bluetooth controller options
# are named BTDM_* — the BT_CTRL_* spellings belong to the C3/S3 and are
# silently ignored here.

# Radio powers down between connection events. Biggest single saving, and it
# works on any board.
CONFIG_BTDM_CTRL_MODEM_SLEEP=y
CONFIG_BTDM_CTRL_MODEM_SLEEP_MODE_ORIG=y

# BLE low-power clock source. The main crystal supports modem sleep together
# with dynamic frequency scaling, but NOT light sleep (it stops), so the
# controller pins the CPU awake for as long as BLE is up. This is the only
# choice that is safe on a board without a 32.768 kHz crystal.
CONFIG_BTDM_CTRL_LPCLK_SEL_MAIN_XTAL=y

# Dynamic frequency scaling; the actual min/max come from esp_pm_configure() in
# src/power.rs.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3

# --- Boards WITH a 32.768 kHz crystal on 32K_XP/32K_XN ---
# Swap the LPCLK line above for this block and set LIGHT_SLEEP = true in
# src/power.rs. Only then does the chip actually power down between events.
#CONFIG_RTC_CLK_SRC_EXT_CRYS=y
#CONFIG_BTDM_CTRL_LPCLK_SEL_EXT_32K_XTAL=y
#CONFIG_BTDM_BLE_DEFAULT_SCA_500PPM=y
#CONFIG_PM_SLP_IRAM_OPT=y
#CONFIG_PM_RTOS_IDLE_OPT=y

# --- Logging ---
# Console output holds an APB frequency lock while it drains, so this is not
# free. Drop to LOG_DEFAULT_LEVEL_WARN to silence the per-press info! lines.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
